{
  "name": "knayi-myscript",
  "version": "3.0.0-next.0",
  "description": "Knayi Myanmar languages JavaScript library",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./compat": {
      "types": "./src/compat/index.d.ts",
      "default": "./src/compat/index.js"
    },
    "./stream": {
      "types": "./src/stream.d.ts",
      "default": "./src/stream.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "knayi": "./bin/knayi.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": [
    "./dist/knayi-myscript.min.js"
  ],
  "files": [
    "bin",
    "src",
    "!src/spec",
    "dist/knayi-myscript.min.mjs",
    "dist/knayi-myscript-compat.min.mjs",
    "dist/knayi-myscript.min.js"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\" && node --test \"test/**/*.timing.js\" \"test/**/*.timing.mjs\" && tsc -p typecheck/tsconfig.json --noEmit && tsc -p typecheck/tsconfig.no-interop.json --noEmit && tsc -p typecheck/next/tsconfig.json --noEmit",
    "posttest": "node scripts/check-size.js",
    "test:bun": "bun scripts/bun-contract.js && bun scripts/bun-esm.mjs && bun scripts/bun-matrix.js && bun test ./test && bun test ./test/growth.timing.js ./test/next/*.timing.mjs ./test/next/api/*.timing.mjs",
    "test:pack": "node scripts/check-packed.mjs",
    "test:fuzz": "node --test test/fuzz.test.js test/properties.test.js \"test/next/**/*.fuzz.test.mjs\"",
    "test:fuzz:next": "node --test \"test/next/**/*.fuzz.test.mjs\"",
    "test:browser": "playwright test -c scripts/browser/playwright.config.js",
    "check:size": "node scripts/check-size.js --modules",
    "check:dist": "node scripts/check-dist.js",
    "check:redos": "node scripts/check-redos.mjs",
    "check:types": "node scripts/check-types.mjs",
    "matrix:update": "node scripts/contract/update.js",
    "compare": "node scripts/eval/compare.mjs",
    "perf": "node scripts/eval/perf.mjs",
    "eval": "node scripts/eval/run.mjs",
    "bench": "node scripts/eval/bench.mjs",
    "bench:page": "node scripts/eval/page.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenlikeorange/knayi-myscript.git"
  },
  "keywords": [
    "Myanmar",
    "Language",
    "Font",
    "Zawgyi",
    "Unicode",
    "Convert",
    "Detecting",
    "Localzation",
    "Normalization",
    "JavaScript"
  ],
  "contributors": [
    "greenlikeorange <ty@kny.co>",
    "Aung Myo Kyaw <me@aungmyokyaw.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/greenlikeorange/knayi-myscript/issues"
  },
  "homepage": "https://github.com/greenlikeorange/knayi-myscript",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "acorn": "8.18.0",
    "esbuild": "0.25.12",
    "fast-check": "4.10.2",
    "myanmar-tools": "1.1.3",
    "recheck": "4.5.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "myanmar-tools": ">=1.1.2 <1.2.0"
  },
  "peerDependenciesMeta": {
    "myanmar-tools": {
      "optional": true
    }
  }
}
